# ============================================================================
# Platformer routing
# ============================================================================

RewriteEngine on

# Security: never serve dotfiles (.env, .git, ...) or backup/dump/log files
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(bak|orig|swp|sql|log|ini|sh)$ - [F,L]

# 1. Existing files and directories are served as they are
RewriteCond %{REQUEST_FILENAME} -f [NC,OR]
RewriteCond %{REQUEST_FILENAME} -d [NC]
RewriteRule .* - [R=307,L]

# 2. URLs ending in .html
RewriteCond %{REQUEST_URI}  .*\.html.*$
RewriteRule (.*)\.html&(.*)$    index.php?CBroute=$1&$2             [L]
RewriteRule (.*)\.html$       index.php?CBroute=$1&%{QUERY_STRING}   [L]

# 3. URLs with trailing slash
RewriteCond %{REQUEST_URI}  .*/.*$
RewriteRule (.*)/&(.*)$        index.php?CBroute=$1&$2             [L]
RewriteRule (.*)/$           index.php?CBroute=$1&%{QUERY_STRING}   [L]

# 4. Everything else without file extension
RewriteCond %{REQUEST_URI} !\..+$
RewriteRule ^(.*)$           index.php?CBroute=$1&%{QUERY_STRING}   [L]

# 5. Fallback
RewriteCond %{REQUEST_URI}  (.*)                   [OR]
RewriteCond %{REQUEST_FILENAME}  (.*)
RewriteRule .*     index.php?CBroute=$1&filename=$2            [L,QSA]